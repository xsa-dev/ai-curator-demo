# Default: browser-local mocks, no secrets or database needed.
NEXT_PUBLIC_DEMO_MODE="true"

# Optional SQL + LLM mode: set NEXT_PUBLIC_DEMO_MODE=false and configure below.
# Direct connection for Prisma CLI migrations / seed.
DATABASE_URL="postgresql://USER:PASSWORD@DIRECT_HOST/curator?sslmode=require"
# Pooled connection for Next.js runtime (Neon -pooler host or Supabase transaction pooler).
POOL_DATABASE_URL="postgresql://USER:PASSWORD@POOL_HOST/curator?sslmode=require&pgbouncer=true&connection_limit=1"
GROQ_API_KEY=""
LLM_PROVIDER="groq"
# Llama 3.3 retired on Groq free/developer tier; override for enterprise if available.
GROQ_MODEL="openai/gpt-oss-120b"
GOOGLE_GENERATIVE_AI_API_KEY=""
GOOGLE_MODEL="gemini-2.5-flash"
# Explicit opt-in: x-user-id is demo impersonation, NOT authentication.
DEMO_AUTH_ENABLED="true"
# Optional Basic Auth gate for a private Vercel demo; leave empty for localhost.
DEMO_GATE_USER=""
DEMO_GATE_PASSWORD=""
# Dedicated disposable PostgreSQL, never your application database.
TEST_DATABASE_URL="postgresql://curator:curator@localhost:5433/curator_test"
TEST_DATABASE_RESET="yes"
